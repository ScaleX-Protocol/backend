# =============================================================================
# PONDER CONFIGURATION - CORE CORE_DEVNET ENVIRONMENT (ScaleX-CORE_DEVNET/31337)
# =============================================================================

# Database Configuration - Core Chain Database
PONDER_DATABASE_URL=postgresql://postgres:password@localhost:5432/ponder_core
PONDER_TELEMETRY_DISABLED=true
PONDER_PORT=42070

# Redis Configuration - Shared with Chain-Specific Keys
REDIS_URL=redis://localhost:6379

# =============================================================================
# NETWORK PERFORMANCE SETTINGS - CORE CHAIN OPTIMIZED
# =============================================================================

# Core chain polling (reduced to avoid RPC overload)
SCALEX_CORE_DEVNET_POLLING_INTERVAL=2000
FAUCET_POLLING_INTERVAL=2000

# Core chain request limits (reduced to avoid RPC overload)
SCALEX_CORE_DEVNET_MAX_REQUESTS_PER_SECOND=20
FAUCET_MAX_REQUESTS_PER_SECOND=10

# Fallback defaults
POLLING_INTERVAL=1000
MAX_REQUESTS_PER_SECOND=10

# =============================================================================
# CHAIN ENDPOINTS - LOCAL ANVIL (Chain ID 31337)
# =============================================================================

# Local Anvil (Main Chain - 31337)
CHAIN_ID=84532
CORE_DEVNET_ENDPOINT=https://base-sepolia.rpc.hypersync.xyz/b1911b22-5acf-4ce4-91aa-4ca2136b4118,https://base-sepolia.rpc.hypersync.xyz/1065ce58-bee3-402e-bb0b-962fedcd764d,https://base-sepolia.rpc.hypersync.xyz/b1911b22-5acf-4ce4-91aa-4ca2136b4118,https://base-sepolia.g.alchemy.com/v2/jBG4sMyhez7V13jNTeQKfVfgNa54nCmF,https://base-sepolia.g.alchemy.com/v2/8veUGQ7WZwqP5MqGPAM5r

