POOLMANAGER_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0x597bc440F5BC758f698e7e23825E41a4d2b1C3ec
TOKENREGISTRY_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0xA5040df4796836F1CACd150bB01Bc9B661b259d2
SYNTHETICTOKENFACTORY_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0xe7a87EA659510d6195e16BF0177d90883486e19a

# Oracle and Lending Contracts (Latest Deployment from 84532.json)
