# =============================================================================
# PONDER CONFIGURATION - LISK SEPOLIA ENVIRONMENT (Chain ID 4202)
# =============================================================================

# Database Configuration - Using shared infrastructure from monitoring-tools
PONDER_DATABASE_URL=postgresql://postgres:password@postgres-database:5432/ponder_lisk_sepolia
PONDER_TELEMETRY_DISABLED=true
PONDER_PORT=42070

# Redis Configuration - Using shared infrastructure from monitoring-tools
REDIS_URL=redis://redis:6379

# =============================================================================
# NETWORK PERFORMANCE SETTINGS - LISK SEPOLIA OPTIMIZED
# =============================================================================

# Lisk Sepolia polling (reduced to avoid RPC overload)
SCALEX_CORE_DEVNET_POLLING_INTERVAL=2000
FAUCET_POLLING_INTERVAL=2000

# Lisk Sepolia request limits (reduced to avoid RPC overload)
SCALEX_CORE_DEVNET_MAX_REQUESTS_PER_SECOND=20
FAUCET_MAX_REQUESTS_PER_SECOND=10

# Fallback defaults
POLLING_INTERVAL=1000
MAX_REQUESTS_PER_SECOND=10

# =============================================================================
# CHAIN ENDPOINTS - LISK SEPOLIA (Chain ID 4202)
# =============================================================================

# Lisk Sepolia (Main Chain - 4202)
CHAIN_ID=4202
CORE_DEVNET_ENDPOINT=https://lisk-sepolia.drpc.org


# =============================================================================
# CONTRACT ADDRESSES - LISK SEPOLIA (4202) ONLY
# =============================================================================

# Core Trading Contracts (Latest Deployment from 4202.json)
SCALEXROUTER_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0x0280D808e55EEF601baA7f516A911c8d7469FB77
BALANCEMANAGER_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0x35C0de28D4917F7017A57401370feA6A38121FC8
POOLMANAGER_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0x6a8cb46fBC1056A18c61DFdd6AE48A0Ebfd62864
TOKENREGISTRY_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0xa6cF3322C223797C51E9a7325fBf4b973370EdFE
SYNTHETICTOKENFACTORY_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0x90c5f923F22F92F0249EAE28E10176778e203E1d

# Oracle and Lending Contracts (Latest Deployment from 4202.json)
ORACLE_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0x9AA212Ddd987FBcD0D058206159098802Da10868
LENDINGMANAGER_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0x86ad7E133e6bA69b0Cd05a7B173a195ceA6a51F2
# Faucet Contract (Lisk Sepolia - No faucet deployed on chain 4202)
# FAUCET_SCALEX_CORE_DEVNET_ADDRESS=
# FAUCET_BEACON_SCALEX_CORE_DEVNET_ADDRESS=

# Hyperlane Mailbox (Lisk Sepolia)
MAILBOX_SCALEX_CORE_DEVNET_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# START BLOCKS - LISK SEPOLIA NETWORK
# =============================================================================

# Start from block where latest contracts were deployed
START_BLOCK=31447872
SCALEX_CORE_DEVNET_START_BLOCK=31447872
# SCALEX_CORE_DEVNET_END_BLOCK=  # Comment out to enable live indexing
FAUCET_START_BLOCK=31447872
# FAUCET_END_BLOCK=  # Comment out to enable live indexing

# =============================================================================
# WEBSOCKET CONFIGURATION - LISK SEPOLIA
# =============================================================================

ENABLE_WEBSOCKET=true
ENABLE_WEBSOCKET_LOG=true
ENABLE_EVENT_PUBLISHING=true
WEBSOCKET_URL=ws://host.docker.internal:8545
START_WEBSOCKET_BLOCK=31447872
PING_INTERVAL=30000
RECONNECT_INTERVAL=3000
AUTO_RECONNECT=true

# =============================================================================
# WALLET CONFIGURATION - LISK SEPOLIA
# =============================================================================

WALLET_SEED_PHRASE=casual miracle grass join song cupboard diary foam lend void right edge

# =============================================================================
# APPLICATION SETTINGS - LISK SEPOLIA ENVIRONMENT
# =============================================================================

NETWORK=lisk-sepolia
USE_RAW_SQL=true
USE_STATIC_POOL_DATA=false
CLOB_DEX_PATH=/Users/renaka/gtx/clob-dex

# =============================================================================
# DEPLOYMENT METADATA - LISK SEPOLIA
# =============================================================================

# Chain Information
SCALEX_CORE_DEVNET_CHAIN_ID=4202
SCALEX_CORE_DEVNET_NETWORK_NAME=LISK SEPOLIA

# Deployment Environment
DEPLOYMENT_ENV=testnet
DEPLOYMENT_TYPE=core-chain

# =============================================================================
# DEBUG AND MONITORING - LISK SEPOLIA
# =============================================================================

# Enable debug logging for development
DEBUG_MODE=true
LOG_LEVEL=debug
ENABLE_CONTRACT_VERIFICATION=false

# Performance monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# NETWORK CONFIGURATIONS - LISK SEPOLIA
# =============================================================================

# Block confirmation requirements
SCALEX_CORE_DEVNET_CONFIRMATIONS=1

# Transaction timeout settings (milliseconds)
SCALEX_CORE_DEVNET_TIMEOUT=30000

# Retry configurations
MAX_RETRIES=3
RETRY_DELAY=1000

# Finality block count for indexer (prevents database lock deadlock)
# Lisk Sepolia L2 requires 12 blocks for safe finality
FINALITY_BLOCK_COUNT=12

# =============================================================================
# INDEXER SPECIFIC SETTINGS - LISK SEPOLIA
# =============================================================================

# Batch processing sizes
SCALEX_CORE_DEVNET_BATCH_SIZE=100

# Event processing
PROCESS_HISTORICAL_EVENTS=true
EVENT_BATCH_SIZE=50

# Cache settings
ENABLE_CACHING=true
CACHE_TTL=300
USE_STATIC_TOKEN_DATA=true

# =============================================================================
# FAUCET CONFIGURATION - LISK SEPOLIA
# =============================================================================

# Global faucet configuration
FAUCET_PRIVATE_KEY=0x5d34b3f860c2b09c112d68a35d592dfb599841629c9b0ad8827269b94b57efca
FAUCET_DEFAULT_AMOUNT=1000

# Chain RPC Configuration for Faucet
FAUCET_RPC_URL_4202=https://lisk-sepolia.drpc.org

OTEL_BASE_URL=http://otel-collector:4318
# OTEL Service Name
OTEL_SERVICE_NAME=lisk-sepolia-indexer
POOLMANAGER_CONTRACT_RARI_ADDRESS=0x6a8cb46fBC1056A18c61DFdd6AE48A0Ebfd62864
BALANCEMANAGER_CONTRACT_RARI_ADDRESS=0x35C0de28D4917F7017A57401370feA6A38121FC8
ScaleXROUTER_CONTRACT_RARI_ADDRESS=0x0280D808e55EEF601baA7f516A911c8d7469FB77
LENDINGMANAGER_CONTRACT_ADDRESS=0x86ad7E133e6bA69b0Cd05a7B173a195ceA6a51F2
ORACLE_CONTRACT_ADDRESS=0x9AA212Ddd987FBcD0D058206159098802Da10868
TOKENREGISTRY_CONTRACT_ADDRESS=0xa6cF3322C223797C51E9a7325fBf4b973370EdFE
