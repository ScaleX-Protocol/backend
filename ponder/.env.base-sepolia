BALANCEMANAGER_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0x925d7B8dD00AFA78689aa62c916AC3Dc04080218
POOLMANAGER_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0x52cD23183fc81fEB07CAbae2F53D0cec63225dAa
TOKENREGISTRY_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0x4803902241CFCdd221761cac1e107eFAD8bB2C45
SYNTHETICTOKENFACTORY_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0x301266B050Aad2Fae6259eA3c8D4Ed81bc1A2879

# Oracle and Lending Contracts (Latest Deployment from 84532.json)
ORACLE_CONTRACT_SCALEX_CORE_DEVNET_ADDRESS=0x5f31a112D8c51dbD0aB5c16D8cfBdd6b8a87b237
