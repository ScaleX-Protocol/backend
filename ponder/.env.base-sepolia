# =============================================================================
# START BLOCKS - CORE CORE_DEVNET NETWORK
# =============================================================================

# Start from block where latest contracts were deployed
START_BLOCK=35526419
SCALEX_CORE_DEVNET_START_BLOCK=35526419
# SCALEX_CORE_DEVNET_END_BLOCK=  # Comment out to enable live indexing
FAUCET_START_BLOCK=35526419
# FAUCET_END_BLOCK=  # Comment out to enable live indexing

# =============================================================================
# WEBSOCKET CONFIGURATION - CORE CHAIN
# =============================================================================

ENABLE_WEBSOCKET=true
ENABLE_WEBSOCKET_LOG=true
ENABLE_EVENT_PUBLISHING=true
WEBSOCKET_URL=ws://host.docker.internal:8545
START_WEBSOCKET_BLOCK=35526419
PING_INTERVAL=30000
RECONNECT_INTERVAL=3000
AUTO_RECONNECT=true

# =============================================================================
# WALLET CONFIGURATION - CORE CHAIN
# =============================================================================

WALLET_SEED_PHRASE=casual miracle grass join song cupboard diary foam lend void right edge

# =============================================================================
# APPLICATION SETTINGS - CORE CORE_DEVNET ENVIRONMENT
# =============================================================================

NETWORK=base-sepolia
USE_RAW_SQL=true
USE_STATIC_POOL_DATA=false
CLOB_DEX_PATH=/Users/renaka/scalex/clob-dex

# =============================================================================
# DEPLOYMENT METADATA - CORE CHAIN
# =============================================================================

# Chain Information
SCALEX_CORE_DEVNET_CHAIN_ID=84532
SCALEX_CORE_DEVNET_NETWORK_NAME=BASE SEPOLIA

# Deployment Environment
DEPLOYMENT_ENV=local
DEPLOYMENT_TYPE=core-chain

# =============================================================================
# DEBUG AND MONITORING - CORE CHAIN
# =============================================================================

# Enable debug logging for development
DEBUG_MODE=true
LOG_LEVEL=debug
ENABLE_CONTRACT_VERIFICATION=false

# Performance monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# NETWORK CONFIGURATIONS - CORE CHAIN
# =============================================================================

# Block confirmation requirements
SCALEX_CORE_DEVNET_CONFIRMATIONS=1

# Transaction timeout settings (milliseconds)
SCALEX_CORE_DEVNET_TIMEOUT=30000

# Retry configurations
MAX_RETRIES=3
RETRY_DELAY=1000

# Finality block count for indexer (prevents database lock deadlock)
# Base Sepolia L2 requires 12 blocks for safe finality
FINALITY_BLOCK_COUNT=12

# =============================================================================
# INDEXER SPECIFIC SETTINGS - CORE CHAIN
# =============================================================================

# Batch processing sizes
SCALEX_CORE_DEVNET_BATCH_SIZE=100

# Event processing
PROCESS_HISTORICAL_EVENTS=true
EVENT_BATCH_SIZE=50

# Cache settings
ENABLE_CACHING=true
CACHE_TTL=300
USE_STATIC_TOKEN_DATA=true

# =============================================================================
# FAUCET CONFIGURATION - CORE CHAIN
# =============================================================================

# Global faucet configuration
FAUCET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
FAUCET_DEFAULT_AMOUNT=1000

# Chain RPC Configuration for Faucet
FAUCET_RPC_URL_31337=http://host.docker.internal:8545

OTEL_BASE_URL=http://otel-collector:4318
# OTEL Service Name
OTEL_SERVICE_NAME=base-sepolia-indexer
