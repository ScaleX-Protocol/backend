# =============================================================================
# PONDER CONFIGURATION - CORE CORE_DEVNET ENVIRONMENT (ScaleX-CORE_DEVNET/31337)
# =============================================================================

# Database Configuration - Using shared infrastructure from monitoring-tools
PONDER_DATABASE_URL=postgresql://postgres:password@postgres-database:5432/ponder_base_sepolia
# Schema versioning: rename ponder.schema.v1.ts → ponder.schema.v2.ts when onchainTable schema changes.
# Ponder 0.9.x derives the PG schema name from the filename (e.g., "ponder.schema.v1.ts").
# Code-only changes (handlers, optimizations) do NOT require a version bump or resync.
PONDER_TELEMETRY_DISABLED=true
PONDER_PORT=42070

# Redis Configuration - Using shared infrastructure from monitoring-tools
REDIS_URL=redis://redis:6379

# =============================================================================
# NETWORK PERFORMANCE SETTINGS - CORE CHAIN OPTIMIZED
# =============================================================================

# Core chain polling (optimized for production performance)
SCALEX_CORE_DEVNET_POLLING_INTERVAL=500
FAUCET_POLLING_INTERVAL=500

# Core chain request limits (optimized for production performance)
# Tuning: HyperSync supports much higher RPS than standard RPC. Incrementally increase.
# Baseline: 100 | Round 1: 500 | Round 2: 1000 (if stable)
SCALEX_CORE_DEVNET_MAX_REQUESTS_PER_SECOND=500
FAUCET_MAX_REQUESTS_PER_SECOND=50

# Fallback defaults
POLLING_INTERVAL=500
MAX_REQUESTS_PER_SECOND=50

# =============================================================================
# CHAIN ENDPOINTS - LOCAL ANVIL (Chain ID 31337)
# =============================================================================

# Local Anvil (Main Chain - 31337)
CHAIN_ID=84532
CORE_DEVNET_ENDPOINT=https://base-sepolia.rpc.hypersync.xyz/110d9744-a790-4c9d-bc2e-394292d70f91,https://base-sepolia.rpc.hypersync.xyz/b1911b22-5acf-4ce4-91aa-4ca2136b4118,https://base-sepolia.rpc.hypersync.xyz/1065ce58-bee3-402e-bb0b-962fedcd764d,https://base-sepolia.g.alchemy.com/v2/jBG4sMyhez7V13jNTeQKfVfgNa54nCmF,https://base-sepolia.infura.io/v3/9fb134201b9f4087a3a9b5f3aea62fd9

