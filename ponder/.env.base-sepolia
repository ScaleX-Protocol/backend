SCALEX_CORE_DEVNET_POLLING_INTERVAL=500
FAUCET_POLLING_INTERVAL=500

# Core chain request limits (optimized for production performance)
SCALEX_CORE_DEVNET_MAX_REQUESTS_PER_SECOND=100
