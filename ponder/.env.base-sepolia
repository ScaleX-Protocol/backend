BALANCEMANAGER_CONTRACT_RARI_ADDRESS=0x925d7B8dD00AFA78689aa62c916AC3Dc04080218
ScaleXROUTER_CONTRACT_RARI_ADDRESS=0x9dD56a24c180dfF441ed1D9f983E48226830ceEe
LENDINGMANAGER_CONTRACT_ADDRESS=0x4D2B8977d4fE442b1D8fC2515CB085c7840967aA
ORACLE_CONTRACT_ADDRESS=0x5f31a112D8c51dbD0aB5c16D8cfBdd6b8a87b237
TOKENREGISTRY_CONTRACT_ADDRESS=0x4803902241CFCdd221761cac1e107eFAD8bB2C45
