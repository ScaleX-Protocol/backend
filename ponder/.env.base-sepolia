ScaleXROUTER_CONTRACT_RARI_ADDRESS=0x60499B0aa84CF43b1ea68DeFf026E4B7d55A35A8
LENDINGMANAGER_CONTRACT_ADDRESS=0xE77De8893d02665E366506Ce930512651885CbCD
ORACLE_CONTRACT_ADDRESS=0x52c7e9bd555a43a58527855d1D3AEf37131E32a0
