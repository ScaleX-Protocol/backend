# Database Configuration
ENVIO_API_DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Server Configuration
ENVIO_API_PORT=3000
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins. Use * for wildcard or specific domains
# Examples:
# - ENVIO_API_CORS_ORIGIN=*
# - ENVIO_API_CORS_ORIGIN=https://example.com,https://app.example.com
# - ENVIO_API_CORS_ORIGIN=https://*.scalex.money
ENVIO_API_CORS_ORIGIN=*
