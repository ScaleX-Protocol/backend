{
  "name": "clob-indexer",
  "version": "0.0.1",
  "private": true,
  "description": "CLOB Indexer - Multi-service architecture with Ponder indexing, API, analytics, and websocket services",
  "scripts": {
    "start:api": "cd api && npm start",
    "dev:api": "cd api && npm run dev",
    "start:analytics": "cd analytics-service && npm start",
    "dev:analytics": "cd analytics-service && npm run dev",
    "start:websocket": "cd websocket-service && npm start",
    "dev:websocket": "cd websocket-service && npm run dev",
    "start:ponder": "cd ponder && npm run start",
    "dev:ponder": "cd ponder && npm run dev",
    "dev:ponder:core-chain": "cd ponder && npm run dev:core-chain",
    "dev:ponder:side-chain": "cd ponder && npm run dev:side-chain",
    "dev:ponder:both": "cd ponder && npm run dev:both-chains",
    "start:all": "concurrently \"npm run start:api\" \"npm run start:analytics\" \"npm run start:websocket\" \"npm run start:ponder\"",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:analytics\" \"npm run dev:websocket\" \"npm run dev:ponder\""
  },
  "workspaces": [
    "api",
    "analytics-service", 
    "websocket-service",
    "websocket-client",
    "ponder"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.14"
  }
}